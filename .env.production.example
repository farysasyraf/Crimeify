# Crimeify's settings for a cloud host. On Azure App Service, each line is an Application setting (DEPLOY.md, step 5),
# not a file: the image never contains a .env. Fill in the <...> values. Don't commit real passwords anywhere.
# Where a value is in "quotes" here, that is only for a .env file: type it into Azure without the quotes.

APP_NAME=Crimeify
APP_ENV=production
# Make one with: php artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
# The site's public address. https:// makes every link and file address https too.
APP_URL=https://<your-site>.azurewebsites.net

# The host's load balancer passes on the browser's https address and real IP. "*" is right for a host that can only be
# reached through its balancer, as on Azure App Service. Never use "*" on a server that people can reach directly.
TRUSTED_PROXIES=*

# To the container's output, where Azure's log stream reads it.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Azure SQL. DB_HOST is the server's name on its Overview page. The ODBC driver encrypts the connection, and Azure SQL's
# certificate is a real one, so the check stays on (the development .env turns it off for a local server).
DB_CONNECTION=sqlsrv
DB_HOST=<server>.database.windows.net
DB_PORT=1433
DB_DATABASE=<CrimeifyDB>
DB_USERNAME=<database user>
DB_PASSWORD=<password>
DB_TRUST_SERVER_CERTIFICATE=false

# Logins and the rate-limit counters live in the database: the container's disk is wiped on every deploy. The tables
# (dbo.sessions, dbo.cache) come with `php artisan migrate`, which must run before anyone opens a page.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# "true" runs `php artisan migrate --force` each time the container starts. Use it for one start after a release that
# adds a migration, then set it back to false (DEPLOY.md, step 7).
RUN_MIGRATIONS=false

# Email for "Forgot password?". Gmail's 500 a day and personal account aren't for a public site: use a sending service
# (Brevo, Mailgun, Amazon SES, Resend...) and its SMTP details. Check with: php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_HOST=<smtp.your-provider.com>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_FROM_ADDRESS="noreply@<your-domain>"
MAIL_FROM_NAME="Crimeify"

# The street map under the regions. OpenStreetMap's own server is for light use only, so a public site should use a
# tile provider. The address has {z}/{x}/{y} in it; the key goes in the address, so limit it to your site's address
# in the provider's dashboard. The attribution is the credit the provider asks for, shown on the map as written.
# Example (MapTiler's raster tiles; check the provider's current address and terms):
MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=<your-key>
MAP_TILE_ATTRIBUTION="&copy; <a href='https://www.maptiler.com/copyright/'>MapTiler</a> &copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
MAP_TILE_MAX_ZOOM=18
