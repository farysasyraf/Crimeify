{
    "name": "farysasyraf/laravel-saved-routes",
    "description": "Add routes to a Laravel app from a page in the app: each one stored in the database, pointing to one of your controllers, open to everyone logged in or only to chosen roles.",
    "keywords": ["laravel", "routes", "database routes", "dynamic routes", "roles", "admin"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "farysasyraf"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0"
    },
    "suggest": {
        "spatie/laravel-permission": "To limit saved routes to spatie roles with SpatieRoleProvider.",
        "nwidart/laravel-modules": "To point saved routes at controllers inside your modules."
    },
    "autoload": {
        "psr-4": {
            "Farysasyraf\\SavedRoutes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farysasyraf\\SavedRoutes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Farysasyraf\\SavedRoutes\\SavedRoutesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
